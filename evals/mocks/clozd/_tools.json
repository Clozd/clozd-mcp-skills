{
  "tools": [
    {
      "name": "get_programs",
      "description": "List the Clozd programs available to the authenticated user. Call this first to discover programId values for later program-scoped tools.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "annotations": {
        "title": "Get Programs",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "list_filters",
      "description": "List the filterable fields for a program's deals \u2014 the standard Clozd fields (product, region, industry, segment, outcome, businessType, decision, gemTypes, leadSource). Each entry has: field (the key to pass to list_filter_values and to get_deals), displayName, valueType, and exhaustive (whether the field has a complete known value set). Call this first to discover what you can filter by, then call list_filter_values for a field's values before filtering get_deals.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "programId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "programId"
          }
        },
        "required": [
          "programId"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "List Filters",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "list_filter_values",
      "description": "List the valid or observed values for a single deal filter field in a program. Pass a field returned by list_filters. The response has: valueSource (enum | reference | crm_observed | metadata_picklist | metadata_observed), exhaustive (true when the values are the complete valid set, false when they are only values seen in the data), truncated (observed lists are capped at 100 by deal count), and values (each an optional dealCount; a null value is the blank/unspecified bucket). Call this to get exact filter values before filtering get_deals, so you pass real values instead of guessing strings.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "programId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "programId"
          },
          "field": {
            "type": "string",
            "description": "The filter field key from list_filters (e.g. \"region\", \"product\", \"outcome\")."
          }
        },
        "required": [
          "programId",
          "field"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "List Filter Values",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_decision_drivers",
      "description": "List individual decision drivers with aggregated sentiment distribution across a four-point scale (strong negative, negative, positive, strong positive). Use when the user asks which specific drivers are mentioned most often or most negatively, \"What are the most common decision drivers?\", \"Which drivers come up most often?\", or \"What is the sentiment breakdown per driver?\" Returns an array of drivers with driverName, totalMentions, and a sentimentBreakdown object containing strongNegative, negative, positive, and strongPositive counts. Sorted by totalMentions descending. Pass limit to return only the top N drivers. Supports filtering by outcome, competitor, date range, and other shared filters.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "programId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "programId"
          },
          "limit": {
            "description": "Return only the top N decision drivers by mention count",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "outcome": {
            "type": "string",
            "enum": [
              "win",
              "loss"
            ]
          },
          "businessType": {
            "type": "string",
            "enum": [
              "new",
              "existing"
            ]
          },
          "closedDateRange": {
            "type": "object",
            "properties": {
              "from": {
                "description": "Inclusive start date in YYYY-MM-DD format",
                "type": "string",
                "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"
              },
              "to": {
                "description": "Inclusive end date in YYYY-MM-DD format",
                "type": "string",
                "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          },
          "publishedDateRange": {
            "type": "object",
            "properties": {
              "from": {
                "description": "Inclusive start date in YYYY-MM-DD format",
                "type": "string",
                "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"
              },
              "to": {
                "description": "Inclusive end date in YYYY-MM-DD format",
                "type": "string",
                "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          },
          "competitor": {
            "type": "string"
          },
          "industry": {
            "type": "string"
          },
          "segment": {
            "type": "string"
          },
          "region": {
            "description": "Exact match only. One region, or an array of regions to match any of. Region is unstandardized CRM text (e.g. \"UK\", \"UK South\"), so call list_filter_values with field \"region\" first to enumerate the real values, then pass every value you want as an array. Do not guess or use partial strings.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "dealAmount": {
            "type": "object",
            "properties": {
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            }
          },
          "product": {
            "description": "Exact match only. One product name, or an array of product names to match any of. Call list_filter_values with field \"product\" first to enumerate the real product names, then pass every one you want as an array. Do not guess or use partial names.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "leadSource": {
            "type": "string"
          },
          "salesRepName": {
            "type": "string"
          },
          "headcount": {
            "type": "object",
            "properties": {
              "min": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "max": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            }
          },
          "decision": {
            "type": "string",
            "enum": [
              "lost_to_competitor",
              "lost_to_no_decision"
            ]
          },
          "gemTypes": {
            "description": "Filter to deals carrying these Insight Gem types: the built-in types (at_risk, win_back, expansion, feature_request, sales_coaching, case_study) or the program's custom gem types by their custom_ key, as get_insight_gems reports it in gemKey.",
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "at_risk",
                    "win_back",
                    "expansion",
                    "feature_request",
                    "sales_coaching",
                    "case_study"
                  ]
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "description": "A custom gem key (custom_...), as get_insight_gems reports it in gemKey"
                }
              ]
            }
          }
        },
        "required": [
          "programId"
        ]
      },
      "annotations": {
        "title": "Get Decision Drivers",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
